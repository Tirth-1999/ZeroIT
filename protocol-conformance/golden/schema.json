    "transient_result": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "error": {
          "$ref": "#/$defs/transient_error"
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "required": [
        "protocol_version",
        "operation_id",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "retry_after_seconds"
            ]
          },
          "then": {
            "properties": {
              "error": {
                "properties": {
                  "code": {
                    "enum": [
                      "RATE_LIMITED",
                      "SERVICE_UNAVAILABLE",
                      "AUTH_CHECK_UNAVAILABLE"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error": {
                "properties": {
                  "code": {
                    "const": "RATE_LIMITED"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "retry_after_seconds"
            ]
          }
        }
      ]
    },
    "command_result": {
      "oneOf": [
        {
          "$ref": "#/$defs/receipt"
        },
        {
          "$ref": "#/$defs/transient_result"
        }
      ]
    },
